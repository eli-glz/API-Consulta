<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
      <OutputType>WinExe</OutputType>
      <TargetFramework>net8.0-windows</TargetFramework>
      <RootNamespace>ConsultaPoliza.WinForms</RootNamespace>
      <StartupObject>Sub Main</StartupObject>
      <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" /> <!--ClosedXML genera .xlsx sin necesitar Excel instalado. --> 
    <PackageReference Include="PDFsharp-MigraDoc-GDI" Version="6.2.4" /> <!--PDFsharp/MigraDoc genera tablas PDF. -->
  </ItemGroup>

</Project>